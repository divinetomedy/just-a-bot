{
  "name": "just-a-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JUST A BOT — a non-personified, child-safe AI assistant (POC).",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
